[Unit]
Description=go-chunked-streaming-server (ULL-DASH origin)
After=network-online.target
Wants=network-online.target

# StartLimitIntervalSec=0 disables systemd's start-rate limiter. The default gives
# up after 5 restarts in 10s and leaves the unit dead — which is precisely the
# behaviour you do not want at 03:00, because a crash loop that would have cleared
# itself becomes a permanent outage instead.
StartLimitIntervalSec=0

[Service]
Type=simple
User=gochunked
Group=gochunked

# Flags are deliberately limited to ones that do NOT depend on the encoder's DASH
# configuration. Anything derived from availabilityTimeOffset, segment duration or
# timeShiftBufferDepth becomes silently wrong the first time Elemental is
# reconfigured, so retention and read-wait are left off:
#
#   no -d : the encoder issues its own DELETEs for expired segments, which is what
#           bounds memory. Measured: 27,507 DELETEs in one 5h session.
# -idle-sweep is a garbage collector, NOT a DVR window. Files live in a Go map, so
# nothing frees them however old they are. Elemental deletes its own segments as
# they leave the manifest window, but not the last window's worth when an output
# stops, and not at all if it is reconfigured or replaced. 3600s is ~300x a typical
# 12s timeShiftBufferDepth, so it cannot reach live content.
#
# -w holds a GET for a segment that has not arrived yet, instead of returning 404.
#
# It was previously OFF because it had been sized WRONG, not because it is wrong:
# -wait-timeout-ms was 1000 while the manifest advertises
# availabilityTimeOffset="1.800", so a player accepting that invitation was stalled
# for 1.2s and then refused. Every retry moved its position, which is where the
# fluctuating live latency came from.
#
# 2500ms EXCEEDS the 1800ms the manifest invites, which is the whole point. The
# alternative is worse at scale: 404s are not cached at the edge
# (ErrorCachingMinTTL is 1s on 404 and 0 elsewhere), live requests are synchronised
# because every viewer wants the same segment at the same instant, and so every
# early request becomes an origin hit in a burst every segment boundary.
#
# The cost is that a held request occupies a goroutine and a connection for up to
# 2.5s. That is why the goroutine alarm is set high, and why the instance is sized
# for concurrency rather than for memory.
ExecStart=/opt/gochunked/bin/go-chunked-streaming-server \
  -r \
  -i 9094 \
  -o /opt/gochunked/cors.json \
  -p /opt/gochunked/content \
  -ingest-idle-timeout 10 \
  -admin-addr 127.0.0.1:9095 \
  -log-level warn \
  -utc-timing https://time.akamai.com/?iso \
  -idle-sweep 3600 \
  -w \
  -wait-timeout-ms 2500

Restart=always
RestartSec=2

# A guard, not a working limit. Measured steady state is ~25MB.
#
# Expressed as a PERCENTAGE so it scales with the instance. A fixed 4G was wrong in
# both directions: too small for a large ABR ladder, because the sweeper's own bound
# is bitrate x idle-sweep and 20 Mbps at 3600s is ~9GB - the process would be killed
# while working correctly; and needlessly large on a small instance.
#
# Its purpose is to make a runaway die inside its own cgroup rather than invoking the
# kernel OOM killer, which might take sshd or the SSM agent instead.
MemoryMax=25%

# GOMEMLIMIT is deliberately NOT set. It would have to be kept consistent with
# MemoryMax by hand, and it buys nothing here: in a real runaway the memory is live
# (files held in a map), so a harder-working collector cannot reclaim it - it would
# only burn CPU and delay an inevitable kill. Go's default pacing keeps the heap at
# roughly twice the live set, which at 25MB is nowhere near any limit.

# Filesystem hardening. The process needs to read its config and write content;
# nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/gochunked/content
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# Journald only; nothing ships to CloudWatch Logs, where per-request volume would
# cost $150-250/month. journald self-caps at 10% of the filesystem.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
